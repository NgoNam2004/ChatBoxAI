# Gemini API Key — lấy tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port cho backend server (mặc định: 3001)
PORT=3001

# Origin của frontend (để cấu hình CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Khóa ký JWT: chuỗi ngẫu nhiên dài (≥ 32 ký tự). Tuyệt đối không commit giá trị thật.
JWT_SECRET=your_random_secret_here

# Thời hạn token (mặc định: 7d)
JWT_EXPIRES_IN=7d

# Số vòng băm mật khẩu bcrypt (mặc định: 12)
BCRYPT_ROUNDS=12

# URI kết nối MongoDB
MONGODB_URI=mongodb://localhost:27017/fitai-gym

# ── Gemini Model Configuration ──────────────────────────────────────────────
# Model chính (Flash family — nhanh, phù hợp chatbot CSKH)
# Tên hợp lệ theo: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Fallback models khi model chính lỗi liên tục (phân cách bằng dấu phẩy)
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash