# ── Gemini API ──────────────────────────────────────────────────────────────
# Lấy tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ───────────────────────────────────────────────────────────────────
# Port cho backend server (mặc định: 3001)
PORT=3001

# Origin của frontend (để cấu hình CORS)
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────────────────────
# Khóa ký JWT: chuỗi ngẫu nhiên dài (≥ 32 ký tự). Tuyệt đối không commit giá trị thật.
JWT_SECRET=your_random_secret_here

# Thời hạn token (mặc định: 7d)
JWT_EXPIRES_IN=7d

# Số vòng băm mật khẩu bcrypt (mặc định: 12)
BCRYPT_ROUNDS=12

# ── MySQL Database ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=chatboxai

# Bật SSL khi dùng MySQL cloud (Aiven, PlanetScale, RDS, v.v.)
DB_SSL=true

# CA certificate cho SSL — chọn MỘT trong hai cách:
#   Cách 1 (ưu tiên): dán nội dung file ca.pem vào đây, thay newline bằng \n
#                     Ví dụ: DB_CA_CERT=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
#   Cách 2: để trống và đặt file CA vào BE/certs/ca.pem (không commit file này)
# DB_CA_CERT=

# ── Gemini Model ─────────────────────────────────────────────────────────────
# Model chính (Flash family — nhanh, phù hợp chatbot CSKH)
GEMINI_MODEL=gemini-2.5-flash

# Fallback models khi model chính lỗi liên tục (phân cách bằng dấu phẩy)
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash